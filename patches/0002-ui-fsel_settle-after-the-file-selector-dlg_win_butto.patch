+/* a window's own object tree (not a dialog: a program's main window of
+   buttons, EConvert's): a press on its EXIT button o taken as a dialog's
+   are, only when let go over it, shown pressed meanwhile (graf_watchbox).
+   1: let go over it (its SELECTED taken off again; the caller redraws o
+   and acts); 0: not one, the button already up (a click a file selector
+   left: fsel.h), or let go elsewhere. A button that acted on the press
+   emptied EConvert's list on a click it never had (5 Nov 2026) */
+int dlg_win_button(OBJECT *tree, short o);
+
 /* the pen of the first npens (16 at most: the UI's) whose colour is nearest
    r, g, b (VDI's 0-1000), read with vq_color; text: one dark enough to read
    on white, where there is one. A UI colour in 16 colours or fewer is never
diff --git a/common/ui/fsel.c b/common/ui/fsel.c
new file mode 100644
index 0000000..136320f
--- /dev/null
+++ b/common/ui/fsel.c
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Copyright (C) 2026 AERA | Erez Yaary */
+/* fsel.c - the file selector's clicks settled (see fsel.h) */
+#include "gemui.h"
+#include "fsel.h"
+
+void fsel_settle(void)
+{
+	short mx, my, mb, ks, msg[8];
+	AEVENT ev;
+	int n = 0;
+
+	/* the button let go (at most some seconds of polling: a stuck mouse
+	   doesn't hold the program) */
+	do
+		graf_mkstate(&mx, &my, &mb, &ks);
+	while ((mb & 1) && ++n < 2000);
+	/* the button events queued, taken off (a few at most) */
+	for (n = 0; n < 16 && (evnt_multi_(MU_BUTTON | MU_TIMER, 1, 1, 1, 0, msg, &ev) & MU_BUTTON); n++)
+		;
+}
diff --git a/common/ui/fsel.h b/common/ui/fsel.h
new file mode 100644
index 0000000..1b144c2
--- /dev/null
+++ b/common/ui/fsel.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Copyright (C) 2026 AERA | Erez Yaary */
+/*
+ * fsel.h - what to do after the file selector (EConvert's first, 5 Nov
+ * 2026).
+ *
+ * A double click in a file selector can close it on its first click; its
+ * second, and the release, then come to the program's own window as
+ * clicks of their own. A window that takes a button on a press acted on
+ * one: EConvert's Clear emptied the list of files chosen ("it forgets the
+ * file and says there are 0 files to convert", Erez). fsel_settle() waits
+ * for the button to be let go and takes off the button events the
+ * selector left queued; call it as fsel_exinput (or fsel_input) returns.
+ */
+#ifndef FSEL_H
+#define FSEL_H
+
+void fsel_settle(void);
+
+#endif
